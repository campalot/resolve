{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "jsx": "react-jsx",

    "strict": true,

    "baseUrl": ".",

    "paths": {
      "@resolve/ui": ["packages/ui/src"],
      "@resolve/types": ["packages/types/src"],
      "@resolve/utils": ["packages/utils/src"],
      "@resolve/mock-db": ["packages/mock-db/src"],
      "@resolve/domain": ["packages/domain/src"],
      "@resolve/logger": ["packages/logger/src"]
    }
  }
}